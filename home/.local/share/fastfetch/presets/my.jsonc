{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "position": "right",
  },
  "display": {
    "separator": " : ",
    "brightColor": true,
    "key": {
      "width": 16,
    },
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭───────────────────────────────────────────────────────────────╮",
    },
    {
      "type": "kernel",
      "key": "│   OS",
      "keyColor": "blue",
      "format": "{1} {2}",
    },
    {
      "type": "uptime",
      "key": "│ 󱑅  Uptime",
      "keyColor": "blue",
      "format": "{days}d {hours}h {minutes}m",
    },
    {
      "type": "packages",
      "key": "│ 󰏖  Packages",
      "keyColor": "blue",
      "format": "{9} (nix-system), {10} (nix-user)",
    },
    {
      "type": "custom",
      "format": "├───────────────────────────────────────────────────────────────┤",
    },
    {
      "type": "shell",
      "key": "│   Shell",
      "keyColor": "cyan",
    },
    {
      "type": "terminal",
      "key": "│   Terminal",
      "keyColor": "cyan",
    },
    {
      "type": "terminalfont",
      "key": "│   Font",
      "keyColor": "cyan",
    },
    {
      "type": "custom",
      "format": "├───────────────────────────────────────────────────────────────┤",
    },
    {
      "type": "cpu",
      "key": "│ 󰍛  CPU",
      "keyColor": "magenta",
      "showPeCoreCount": true,
    },
    {
      "type": "gpu",
      "key": "│ 󰍛  GPU",
      "keyColor": "magenta",
    },
    {
      "type": "display",
      "key": "│ 󰍹  Display",
      "keyColor": "magenta",
      "compactType": "original-with-refresh-rate",
    },
    {
      "type": "custom",
      "format": "├───────────────────────────────────────────────────────────────┤",
    },
    {
      "type": "memory",
      "key": "│ 󰾆  RAM",
      "keyColor": "green",
      "percent": {
        "type": 9,
      },
    },
    {
      "type": "swap",
      "key": "│ 󰓡  Swap",
      "keyColor": "green",
      "percent": {
        "type": 9,
      },
    },
    {
      "type": "disk",
      "key": "│ 󰋊  Disk",
      "keyColor": "green",
      "folders": "/:/home",
      "percent": {
        "type": 9,
      },
    },
    {
      "type": "custom",
      "format": "├───────────────────────────────────────────────────────────────┤",
    },
    {
      "type": "localip",
      "key": "│ 󰩟  Local IP",
      "keyColor": "yellow",
      "showIpv4": true,
      "showIpv6": false,
      "compact": true,
    },
    {
      "type": "custom",
      "format": "╰───────────────────────────────────────────────────────────────╯",
    },
  ],
}
