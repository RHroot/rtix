[global]
monitor = 0
follow = mouse
width = 400
origin = top-right
offset = (10, 20)
shrink = yes
notification_limit = 8
progress_bar = true
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 300
indicate_hidden = yes
markup = full
padding = 12
horizontal_padding = 14
frame_color = "#9D6BFF"
frame_width = 2
corner_radius = 10
separator_height = 1
separator_color = frame
font = FiraCode Nerd Font 14
alignment = left
transparency = 5
icon_position = left
max_icon_size = 56
enable_recursive_icon_lookup = true
icon_path = /usr/share/icons:/usr/local/share/icons
icon_theme = Papirus-Dark
history_length = 50
sticky_history = yes
show_indicators = yes
sort = yes
stack_duplicates = true
hide_duplicate_count = no
idle_threshold = 0
show_age_threshold = 60
word_wrap = yes
ellipsize = middle
format = "<b>%s</b>\n%b"
browser = xdg-open
mouse_left_click = open_url, close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_current

[urgency_low]
background = "#0A0812"
foreground = "#8A81A6"
highlight = "#372E4D"
timeout = 4
fullscreen = delay

[urgency_normal]
background = "#171029"
foreground = "#F2EEFF"
highlight = "#B26BFF"
timeout = 7
fullscreen = show

[urgency_critical]
background = "#171029"
foreground = "#FFFFFF"
highlight = "#FF6B8D"
timeout = 0
fullscreen = show

[volume]
appname = "pulseaudio|pipewire|volume"
timeout = 2
urgency = low

[screenshot]
summary = "Screenshot saved"
timeout = 2
urgency = low
