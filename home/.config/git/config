[core]
    editor = nvim
    pager = delta
    autocrlf = input
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    syntax-theme = Dracula
    hyperlinks = true
    pager = less
[diff]
    colorMoved = default
[init]
    defaultBranch = master
[pull]
    rebase = true
[push]
    default = current
[color]
    ui = auto
